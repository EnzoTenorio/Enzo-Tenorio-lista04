<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>detalhaPostagem</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f2f4f7;
      margin: 0;
      padding: 30px 16px;
      color: #222;
    }
    .container {
      max-width: 900px;
      margin: 0 auto;
      background: #fff;
      padding: 28px;
      border-radius: 10px;
      box-shadow: 0 2px 10px rgba(0,0,0,.1);
    }
    h1 { margin-top: 0; font-size: 1.5rem; text-align: center; }
    h2 { font-size: 1.1rem; margin: 0 0 10px; border-bottom: 2px solid #1a73e8; padding-bottom: 6px; }
    label { display: block; margin-bottom: 6px; font-weight: bold; }
    select {
      width: 100%;
      padding: 10px;
      font-size: 1rem;
      border: 1px solid #bbb;
      border-radius: 6px;
      margin-bottom: 20px;
      background: #fff;
    }
    .colunas {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 20px;
    }
    @media (max-width: 700px) {
      .colunas { grid-template-columns: 1fr; }
    }
    .painel {
      background: #fafbfc;
      border: 1px solid #e0e3e7;
      border-radius: 8px;
      padding: 16px;
      min-height: 120px;
    }
    ul.lista { list-style: none; margin: 0; padding: 0; }
    ul.lista li {
      padding: 10px;
      margin-bottom: 6px;
      background: #fff;
      border: 1px solid #dde1e6;
      border-radius: 6px;
      color: #1a73e8;
      cursor: pointer;
    }
    ul.lista li:hover { background: #eef5ff; text-decoration: underline; }
    ul.lista li.ativo { background: #dbe9ff; font-weight: bold; }
    .post-titulo { font-size: 1.1rem; font-weight: bold; margin: 0 0 8px; }
    .post-corpo { line-height: 1.5; margin: 0 0 16px; }
    .comentario {
      background: #fff;
      border: 1px solid #e0e3e7;
      border-radius: 6px;
      padding: 10px;
      margin-bottom: 8px;
    }
    .comentario .nome { font-weight: bold; font-size: .95rem; }
    .comentario .email { color: #666; font-size: .85rem; margin-bottom: 6px; }
    .comentario .texto { font-size: .92rem; line-height: 1.4; }
    .vazio { color: #777; }
    .erro {
      background: #fdecea;
      border-left: 4px solid #d93025;
      color: #a50e0e;
      padding: 12px;
      border-radius: 6px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>detalhaPostagem</h1>

    <label for="autor">Autor</label>
    <select id="autor">
      <option value="">Carregando autores...</option>
    </select>

    <div class="colunas">
      <div class="painel">
        <h2>Postagens</h2>
        <div id="postagens"><span class="vazio">Selecione um autor.</span></div>
      </div>

      <div class="painel">
        <h2>Conteúdo e Comentários</h2>
        <div id="detalhe"><span class="vazio">Clique no título de uma postagem.</span></div>
      </div>
    </div>
  </div>

  <script>
    const API = 'https://jsonplaceholder.typicode.com';

    const selectAutor = document.getElementById('autor');
    const divPostagens = document.getElementById('postagens');
    const divDetalhe = document.getElementById('detalhe');

    function mostrarErro(container, texto) {
      container.innerHTML = '';
      const div = document.createElement('div');
      div.className = 'erro';
      div.textContent = texto;
      container.appendChild(div);
    }

    function mostrarTexto(container, texto) {
      container.innerHTML = '';
      const span = document.createElement('span');
      span.className = 'vazio';
      span.textContent = texto;
      container.appendChild(span);
    }

    async function carregarAutores() {
      try {
        const resposta = await fetch(`${API}/users`);
        if (!resposta.ok) throw new Error('Falha ao carregar autores');
        const usuarios = await resposta.json();

        selectAutor.innerHTML = '';
        const padrao = document.createElement('option');
        padrao.value = '';
        padrao.textContent = 'Selecione um autor';
        selectAutor.appendChild(padrao);

        usuarios.forEach((u) => {
          const opt = document.createElement('option');
          opt.value = u.id;
          opt.textContent = u.name;
          selectAutor.appendChild(opt);
        });
      } catch (erro) {
        selectAutor.innerHTML = '<option value="">Erro ao carregar</option>';
        mostrarErro(divPostagens, 'Não foi possível carregar os autores. Tente novamente mais tarde.');
      }
    }

    async function carregarPostagens(userId) {
      mostrarTexto(divPostagens, 'Carregando postagens...');
      mostrarTexto(divDetalhe, 'Clique no título de uma postagem.');

      try {
        const resposta = await fetch(`${API}/posts?userId=${userId}`);
        if (!resposta.ok) throw new Error('Falha ao carregar postagens');
        const posts = await resposta.json();

        if (posts.length === 0) {
          mostrarTexto(divPostagens, 'Este autor não possui postagens.');
          return;
        }

        const ul = document.createElement('ul');
        ul.className = 'lista';

        posts.forEach((post) => {
          const li = document.createElement('li');
          li.textContent = post.title;
          li.addEventListener('click', () => {
            ul.querySelectorAll('li').forEach((item) => item.classList.remove('ativo'));
            li.classList.add('ativo');
            detalharPostagem(post);
          });
          ul.appendChild(li);
        });

        divPostagens.innerHTML = '';
        divPostagens.appendChild(ul);
      } catch (erro) {
        mostrarErro(divPostagens, 'Não foi possível carregar as postagens. Tente novamente.');
      }
    }

    async function detalharPostagem(post) {
      divDetalhe.innerHTML = '';

      const titulo = document.createElement('p');
      titulo.className = 'post-titulo';
      titulo.textContent = post.title;

      const corpo = document.createElement('p');
      corpo.className = 'post-corpo';
      corpo.textContent = post.body;

      const tituloComentarios = document.createElement('h2');
      tituloComentarios.textContent = 'Comentários';

      const areaComentarios = document.createElement('div');
      mostrarTexto(areaComentarios, 'Carregando comentários...');

      divDetalhe.appendChild(titulo);
      divDetalhe.appendChild(corpo);
      divDetalhe.appendChild(tituloComentarios);
      divDetalhe.appendChild(areaComentarios);

      try {
        const resposta = await fetch(`${API}/posts/${post.id}/comments`);
        if (!resposta.ok) throw new Error('Falha ao carregar comentários');
        const comentarios = await resposta.json();

        areaComentarios.innerHTML = '';

        if (comentarios.length === 0) {
          mostrarTexto(areaComentarios, 'Nenhum comentário.');
          return;
        }

        comentarios.forEach((c) => {
          const box = document.createElement('div');
          box.className = 'comentario';

          const nome = document.createElement('div');
          nome.className = 'nome';
          nome.textContent = c.name;

          const email = document.createElement('div');
          email.className = 'email';
          email.textContent = c.email;

          const texto = document.createElement('div');
          texto.className = 'texto';
          texto.textContent = c.body;

          box.appendChild(nome);
          box.appendChild(email);
          box.appendChild(texto);
          areaComentarios.appendChild(box);
        });
      } catch (erro) {
        mostrarErro(areaComentarios, 'Não foi possível carregar os comentários. Tente novamente.');
      }
    }

    selectAutor.addEventListener('change', () => {
      const id = selectAutor.value;
      if (!id) {
        mostrarTexto(divPostagens, 'Selecione um autor.');
        mostrarTexto(divDetalhe, 'Clique no título de uma postagem.');
        return;
      }
      carregarPostagens(id);
    });

    carregarAutores();
  </script>
</body>
</html>
